# Настройки базы данных
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_HOST=postgres
DB_PORT=5432
MONGO_URI=mongodb://student:student_secure_password@mongodb:27017/smart_home?authSource=admin

# Настройки приложения
APP_HOST=0.0.0.0
APP_PORT=4200
APP_ENV=development   # development / production

# Настройки JWT
JWT_ACCESS_SECRET=super_secret_access_key
JWT_REFRESH_SECRET=super_secret_refresh_key
JWT_ACCESS_EXPIRATION=15
JWT_REFRESH_EXPIRATION=10080

# Настройки OAuth Yandex
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_CALLBACK_URL=http://localhost:4200/auth/oauth/yandex/callback

# Настройки Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
CACHE_TTL_DEFAULT=300

# Настройки MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secure_password
MINIO_BUCKET=smart-home-files
MINIO_USE_SSL=false
MAX_FILE_SIZE=10485760  # 10 MB
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg

# Для локальной разработки (если MinIO запущен отдельно)
MINIO_EXTERNAL_ENDPOINT=localhost:9000